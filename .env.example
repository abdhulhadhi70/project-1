# Copy to .env.local for local development. In Cloudflare, add the same
# names under Workers & Pages → your project → Settings → Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never paste into the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Dashboard (used from Phase 3)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site address, used for links in WhatsApp messages, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
